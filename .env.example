# Database: create a free project at https://neon.tech and paste the connection strings.
# DATABASE_URL = pooled connection (used by the app), DIRECT_URL = direct connection (used for migrations).
DATABASE_URL=
DIRECT_URL=

# Auth: any random string of 32+ characters (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional (can stay empty while developing)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@bbqstore.pk
NEXT_PUBLIC_APP_URL=http://localhost:3000
